use "xdraw/palette" as palette

diagram "Language design" {
  map: section "XDraw" {
    arrange tree {
      root = root
      direction = right
      level-gap = 90
      sibling-gap = 28
    }

    root: rectangle "XDraw" { style = palette.accent }
    syntax: rectangle "Syntax"
    layout: rectangle "Layout"
    output: rectangle "Output"
    ids: rectangle "Stable IDs"
    strings: rectangle "Readable strings"
    row: rectangle "Rows"
    graph: rectangle "Graphs"
    excalidraw: rectangle "Excalidraw"
    svg: rectangle "SVG"

    root -> syntax
    root -> layout
    root -> output
    syntax -> ids
    syntax -> strings
    layout -> row
    layout -> graph
    output -> excalidraw
    output -> svg
  }
}
