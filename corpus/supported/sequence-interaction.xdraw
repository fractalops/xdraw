use "xdraw/sequence" as seq

diagram "Checkout interaction" {
  checkout: seq.diagram {
    customer: seq.participant "Customer"
    store: seq.participant "Store"
    payment: seq.participant "Payment service"

    place_order: customer -> store "Place order"
    authorize: store -> payment "Authorize payment"
    approved: payment -> store "Payment approved"
  }
}
