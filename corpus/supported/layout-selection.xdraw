use "xdraw/palette" as palette
use "xdraw/process" as process

diagram "Layout selection" {
  assess: process.lane "Requirements" {
    arrange row { gap = 110 }

    evidence: rectangle "Scene graph" { style = palette.info }
    decision: rectangle "Capability check" { style = palette.warning }
    evidence -> decision "inspect"
  }

  outcomes: process.lane "Adapter outcome" {
    arrange row { gap = 70 }

    hold: rectangle "Reject unsupported" { style = palette.danger }
    arranged_scene: rectangle "Arrange scene" { style = palette.success }
  }
}
