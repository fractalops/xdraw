use "xdraw/palette" as palette
use "xdraw/process" as process
use "xdraw/cards" as cards

diagram "Asset pipeline" {
  subtitle "Local files are resolved before scene compilation"

  ingest: process.lane "Resolution" {
    arrange row { gap 150 }

    source: cards.card "Asset path" { style palette.info }
    raw: cards.card "Validated bytes" { style palette.neutral }
    load: source -> raw "read safely"
  }

  transform: process.lane "Emission" {
    arrange row { gap 110 }

    enriched: cards.card "Embedded file" { style palette.warning }
    curated: cards.card "Image element" { style palette.success }
    publish: enriched -> curated "attach"
  }
}
