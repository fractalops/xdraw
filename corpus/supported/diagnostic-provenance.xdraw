use "xdraw/annotations" as annotations

diagram "Diagnostic provenance" {
  source: rectangle "Source statement"
  target: rectangle "Compiler diagnostic"
  compare: source -> target "retains span"

  mismatch: annotations.note "XD1004 at line 8, column 5" {
    attach target@bottom
  }
  owner: annotations.callout "Show one actionable explanation"
  assignment: owner -> mismatch
}
