use "xdraw/palette" as palette
use "xdraw/process" as process

diagram "Hosted scene workflow" {
  owner: process.lane "Local CLI" {
    submit: rectangle "Compile patch"
  }

  reviewer: process.lane "Excalidraw+" {
    arrange row { gap = 100 }

    assess: diamond "Scene exists?"
    approve: rectangle "Apply edit" { style = palette.success }
    accepted: assess -> approve "yes"
  }

  review_request: owner.submit@south -> reviewer.assess@north "REST request"
}
