use "xdraw/palette" as palette
use "xdraw/process" as process
use "xdraw/cards" as cards

diagram "Approval process" {
  owner: process.lane "Owner" {
    submit: cards.card "Submit"
  }

  reviewer: process.lane "Reviewer" {
    arrange row { gap 60 }

    assess: diamond "Assess"
    approve: cards.card "Approve" { style palette.success }
    accepted: assess -> approve "yes"
  }

  review_request: owner.submit@bottom -> reviewer.assess@top "request review"
}
