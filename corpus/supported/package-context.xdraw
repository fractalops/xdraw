use "xdraw/architecture" as arch

diagram "XDraw package context" {
  analyst: arch.person "Author"

  platform: section "XDraw" {
    arrange row { gap = 100 }

    ingest: arch.system "Compiler"
    warehouse: arch.database "Scene JSON"
    loads: ingest -> warehouse "emits"
  }

  verifies: analyst -> platform "writes DSL"
}
