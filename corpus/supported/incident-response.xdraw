use "xdraw/palette" as palette
use "xdraw/process" as process
use "xdraw/cards" as cards

diagram "Incident response" {
  response: process.lane "Response" {
    arrange row { gap 35 }

    alert: cards.card "Alert" { style palette.danger }
    triage: cards.card "Triage" { style palette.warning }
    contain: cards.card "Contain" { style palette.info }
    recover: cards.card "Recover" { style palette.success }

    detected: alert -> triage { style palette.danger }
    investigate: triage -> contain { stroke-style dashed }
    restored: contain -> recover { style palette.success }
  }
}
