use "xdraw/architecture" as arch
use "xdraw/containers" as containers

diagram "Data platform context" {
  analyst: arch.person "Analyst"

  platform: containers.section "Data platform" {
    arrange row { gap 70 }

    ingest: arch.system "Ingestion"
    warehouse: arch.database "Warehouse"
    loads: ingest -> warehouse "loads"
  }

  verifies: analyst -> platform "verifies data"
}
