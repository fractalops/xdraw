use "xdraw/architecture" as arch

diagram "Component expansion" {
  service: template(name) {
    api: arch.system "${name} parser"
    store: arch.database "${name} output"
    api -> store
  }

  actor: template(name) {
    user: arch.person "${name} author"
  }

  queue: template(name) {
    broker: ellipse "${name} stage"
  }

  local: service "Local"
  hosted: service "Hosted"
  beginner: actor "New"
  maintainer: actor "Maintainer"
  syntax: queue "Syntax"
  semantic: queue "Semantic"
}
