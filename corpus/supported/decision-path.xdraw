use "xdraw/palette" as palette
use "xdraw/process" as process
use "xdraw/cards" as cards

diagram "Release decision" {
  assess: process.lane "Assessment" {
    arrange row { gap 70 }

    evidence: cards.card "Evidence" { style palette.info }
    decision: cards.card "Review" { style palette.warning }
    evidence -> decision
  }

  outcomes: process.lane "Outcomes" {
    arrange row { gap 70 }

    hold: cards.card "Hold" { style palette.danger }
    release: cards.card "Release" { style palette.success }
  }
}
