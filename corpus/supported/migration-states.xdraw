use "xdraw/palette" as palette
use "xdraw/process" as process
use "xdraw/cards" as cards

diagram "Migration states" {
  state: process.lane "Dataset" {
    arrange row { gap 50 }

    source: cards.card "Production" {
      body "Pinned source version"
      style palette.info
    }
    candidate: cards.card "Candidate" {
      body "Transformation complete"
      style palette.warning
    }
    verified: cards.card "Verified" {
      body "Evidence published"
      style palette.success
    }

    migrate: source -> candidate "migrate"
    compare: candidate -> verified "compare" { style palette.success }
  }
}
