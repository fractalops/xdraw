use "xdraw/annotations" as annotations
use "xdraw/architecture" as arch
use "xdraw/cards" as cards
use "xdraw/containers" as containers
use "xdraw/palette" as palette
use "xdraw/sequence" as seq

diagram "Product delivery overview" {
  subtitle "From an idea to a monitored release"
  arrange grid { columns 2; spacing normal }

  plan: containers.section "1. Plan" {
    arrange row { spacing normal }
    idea: cards.card "Prioritized idea" { style palette.info }
    design: cards.card "Technical design"
    idea -> design "refine"
    scope: annotations.note "Agree the outcome before implementation." { attach design@bottom }
  }

  build: containers.section "2. Build" {
    arrange row { spacing normal }
    code: arch.system "Application code"
    verify: arch.system "Automated checks" { style palette.success }
    artifact: arch.database "Versioned artifact"
    code -> verify "validate"
    verify -> artifact "publish"
  }

  release: containers.section "3. Release" {
    arrange row { spacing normal }
    approve: diamond "Ready to release?"
    deploy: arch.system "Deployment"
    approve -> deploy "approved"
  }

  operate: containers.section "4. Operate" {
    arrange row { spacing normal }
    service: arch.system "Running service"
    telemetry: arch.database "Telemetry"
    response: cards.card "Incident response" { style palette.warning }
    service -> telemetry "emits"
    telemetry -> response "alerts"
  }

  architecture: group {
    arrange row { spacing airy }
    user: arch.person "User"
    gateway: arch.system "Gateway"
    worker: arch.system "Worker"
    records: arch.database "Records"
    user -> gateway "request"
    gateway -> worker "dispatch"
    worker -> records "store"
  }

  interaction: seq.diagram {
    operator: seq.participant "Operator"
    platform: seq.participant "Platform"
    monitor: seq.participant "Monitor"
    operator -> platform "Deploy"
    platform -> monitor "Health signal"
    monitor -> operator "Status"
  }

  outcomes: containers.section "Release outcome" {
    arrange tree { root outcome; direction right }
    outcome: cards.card "Release outcome"
    healthy: cards.card "Healthy"
    unhealthy: cards.card "Unhealthy"
    continue_rollout: cards.card "Continue rollout"
    rollback: cards.card "Roll back"
    investigate: cards.card "Investigate"
    outcome -> healthy
    outcome -> unhealthy
    healthy -> continue_rollout
    unhealthy -> rollback
    unhealthy -> investigate
  }
}
