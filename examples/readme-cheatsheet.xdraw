use "xdraw/cards" as cards
use "xdraw/containers" as containers
use "xdraw/palette" as palette

diagram "XDraw quick reference" {
  subtitle "Declare editable shapes, compose them, and let XDraw arrange the scene"

  default: theme { font-family normal }
  arrange compact { width 2200; gap 26 }

  anatomy: containers.section "1. Read a declaration" {
    arrange column { gap 20 }

    declaration: code """
      request: rectangle "Request" {
        body "Supporting detail"
        style palette.info
      }
    """ {
      title "<id>: <constructor> \"label\" { properties and children }"
      language xdraw
      line-numbers false
      highlight true
    }

    parts: group {
      arrange row { gap 28 }
      id: cards.card "request" { body "Stable source ID"; style palette.neutral }
      constructor: cards.card "rectangle" { body "Core primitive"; style palette.accent }
      label: cards.card "Request" { body "Visible text"; style palette.info }
      block: cards.card "{ ... }" { body "Properties and children"; style palette.success }
    }
  }

  vocabulary: containers.section "2. Start with primitives" {
    arrange row { gap 24 }

    shapes: code """
      rectangle
      ellipse
      diamond
      freedraw
    """ {
      title "Shapes"
      language xdraw
      line-numbers false
      highlight true
    }

    structure: code """
      frame
      group
      text
      code
    """ {
      title "Structure and content"
      language xdraw
      line-numbers false
      highlight true
    }

    definitions: code """
      component
      style
      theme
      asset
      image
    """ {
      title "Reuse and media"
      language xdraw
      line-numbers false
      highlight true
    }
  }

  compose: containers.section "3. Compose the scene" {
    arrange row { gap 24 }

    containment: code """
      platform: frame "Platform" {
        api: rectangle "API"
      }

      platform.api
    """ {
      title "Nest and address"
      language xdraw
      line-numbers false
      highlight true
    }

    connections: code """
      source@right -> target@left "sends"
      source -- target "related"
    """ {
      title "Connect"
      language xdraw
      line-numbers false
      highlight true
    }

    layouts: code """
      arrange row { gap 80 }
      arrange column { gap 24 }
      arrange grid { columns 3 }
      arrange layered { direction right }
    """ {
      title "Arrange"
      language xdraw
      line-numbers false
      highlight true
    }
  }

  example: containers.section "4. Put it together" {
    arrange row { gap 44 }

    source: code """
      diagram "Order flow" {
        arrange row { gap 150 }
        customer: ellipse "Customer"
        api: rectangle "Orders API"
        store: rectangle "Order data"
        customer -> api "places order"
        api -> store "saves"
      }
    """ {
      title "Runnable XDraw"
      language xdraw
      line-numbers false
      highlight true
    }

    result: frame "Editable result" {
      arrange row { gap 150 }
      customer: ellipse "Customer" { style palette.accent }
      api: rectangle "Orders API" { style palette.info }
      store: rectangle "Order data" { style palette.success }
      customer -> api "places order"
      api -> store "saves"
    }
  }
}
