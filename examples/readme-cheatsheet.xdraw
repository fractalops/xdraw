use "xdraw/cards" as cards
use "xdraw/containers" as containers
use "xdraw/palette" as palette

diagram "XDraw quick reference" {
  subtitle "From concise source to an editable Excalidraw scene"

  default: theme { font-family normal; title-size 22; body-size 19 }
  arrange grid { columns 2; gap 28; width 2000 }

  anatomy: containers.section "1. Declare" {
    arrange column { gap 18 }

    declaration: code """
      request: rectangle "Request" {
        body "Supporting detail"
        style palette.info
      }
    """ {
      title "id: constructor \"label\" { properties and children }"
      language xdraw
      line-numbers false
      highlight true
    }

    parts: group {
      arrange row { gap 18 }
      id: cards.card "request" { body "Stable ID"; style palette.neutral }
      constructor: cards.card "rectangle" { body "Primitive"; style palette.accent }
      label: cards.card "Request" { body "Visible label"; style palette.info }
      block: cards.card "{ ... }" { body "Details"; style palette.success }
    }
  }

  vocabulary: containers.section "2. Choose primitives" {
    arrange column { gap 18 }

    primitives: code """
      Shapes       rectangle  ellipse  diamond  freedraw
      Containers   frame      group
      Content      text       code     asset    image
      Reuse        component  style    theme
    """ {
      title "Core constructors"
      language xdraw
      line-numbers false
      highlight true
    }

    forms: code """
      Document     diagram  use  subtitle
      Layout       arrange row | column | grid | layered
      Connections  source -> target   source -- target
      Anchors      node@top | @right | @bottom | @left
    """ {
      title "Forms and operators"
      language xdraw
      line-numbers false
      highlight true
    }
  }

  compose: containers.section "3. Compose" {
    arrange column { gap 18 }

    composition: code """
      platform: frame "Platform" {
        arrange row { gap 100 }
        api: rectangle "API"
        store: rectangle "Data"
        api@right -> store@left "writes"
      }

      platform.api
    """ {
      title "Nest, arrange, connect and address"
      language xdraw
      line-numbers false
      highlight true
    }

    guidance: group {
      arrange row { gap 18 }
      nest: cards.card "Nest" { body "Braces create hierarchy"; style palette.neutral }
      layout_card: cards.card "Arrange" { body "Layouts place siblings"; style palette.accent }
      connect: cards.card "Connect" { body "Arrows remain editable"; style palette.info }
    }
  }

  example: containers.section "4. Build an editable scene" {
    arrange column { gap 18 }

    source: code """
      diagram "Compiler flow" {
        arrange row { gap 160 }
        author: ellipse "Author"
        compiler: rectangle "Compiler"
        scene: rectangle "Scene JSON"
        author -> compiler "writes source"
        compiler -> scene "emits"
      }
    """ {
      title "xdraw build compiler-flow.xdraw"
      language xdraw
      line-numbers false
      highlight true
    }

    result: frame "Editable .excalidraw output" {
      arrange row { gap 160 }
      author: ellipse "Author" { style palette.accent }
      compiler: rectangle "Compiler" { style palette.info }
      scene: rectangle "Scene JSON" { style palette.success }
      author -> compiler "writes source"
      compiler -> scene "emits"
    }
  }
}
