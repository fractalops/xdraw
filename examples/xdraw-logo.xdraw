diagram "" {
  default: theme { font-family normal }

  canvas_top_left: freedraw {
    at (66, 96)
    points ((0, 0), (0, -36), (36, -36))
    stroke "#0f172a"
    stroke-width 1.2
  }

  canvas_top_right: freedraw {
    at (228, 60)
    points ((0, 0), (36, 0), (36, 36))
    stroke "#0f172a"
    stroke-width 1.2
  }

  canvas_bottom_left: freedraw {
    at (66, 220)
    points ((0, 0), (0, 36), (36, 36))
    stroke "#0f172a"
    stroke-width 1.2
  }

  canvas_bottom_right: freedraw {
    at (228, 256)
    points ((0, 0), (36, 0), (36, -36))
    stroke "#0f172a"
    stroke-width 1.2
  }

  curve: freedraw {
    at (72, 60)
    points ((182, 100), (176, 120), (158, 139), (131, 155), (100, 168), (69, 175), (42, 178), (24, 175), (18, 168), (24, 155), (42, 139), (69, 120), (100, 100), (131, 80), (158, 61), (176, 45), (182, 32), (176, 25), (158, 22), (131, 25), (100, 32), (69, 45), (42, 61), (24, 80), (18, 100), (24, 120), (42, 139), (69, 155), (100, 168), (131, 175), (158, 178), (176, 175), (182, 168), (176, 155), (158, 139), (131, 120), (100, 100), (69, 80), (42, 61), (24, 45), (18, 32), (24, 25), (42, 22), (69, 25), (100, 32), (131, 45), (158, 61), (176, 80), (182, 100))
    stroke "#7c3aed"
    stroke-width 2.2
  }

  trace: freedraw {
    at (72, 60)
    points ((182, 100), (176, 120), (158, 139), (131, 155), (100, 168), (69, 175), (42, 178), (24, 175), (18, 168), (24, 155), (42, 139), (69, 120), (100, 100))
    pressures (0.04, 0.16, 0.3, 0.46, 0.58, 0.64, 0.6, 0.5, 0.38, 0.26, 0.16, 0.09, 0.04)
    simulate-pressure false
    stroke "#14b8a6"
    stroke-width 1.5
  }

  wordmark: text "xdraw" {
    at (340, 105)
    font-family code
    font-size 96
    text-color "#0f172a"
  }
}
