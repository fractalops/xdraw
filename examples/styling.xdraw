use "xdraw/architecture" as arch
use "xdraw/containers" as containers

diagram "Styles and themes" {
  base: theme { font-family normal }
  focus: style { stroke "#059669"; background "#ecfdf5"; text-color "#065f46"; title-size 21 }
  examples: containers.section "Elements" {
    source: arch.system "Source system"
    target: ellipse "Verified target" { style focus; link "https://example.com"; locked true }
    source -> target
  }
  caption: text "Styled free text wraps at a declared width." {
    at (100, 350); font-family normal; font-size 18; wrap-width 300; auto-size false
  }
}
