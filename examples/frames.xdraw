use "xdraw/architecture" as arch
use "xdraw/cards" as cards

diagram "Native frames" {
  subtitle "Nested ownership, clipping and inherited locking"

  workspace: frame "Workspace" {
    locked true
    arrange row { gap 220 }
    request: arch.person "Request"
    service: arch.system "Service"
    request -> service "inside frame"

    storage: frame "Storage boundary" {
      records: arch.database "Records"
    }

    service -> storage.records "crosses nested frame"
  }

  movable: frame "Editable frame" {
    draft: cards.card "Draft"
  }
}
