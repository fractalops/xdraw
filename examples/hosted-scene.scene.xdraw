scene excalidraw::default::xdraw::compiler_overview {
  replace {
    use "xdraw/architecture" as arch
    diagram "Hosted compiler overview" {
      browser: arch.person "Author"
      api: arch.system "XDraw compiler"
      data: arch.database "Excalidraw scene"
      browser -> api "applies source"
      api -> data "replaces scene"
    }
  }
}
