use "xdraw/architecture" as arch
use "xdraw/palette" as palette

diagram "XDraw cheatsheet" {
  subtitle "A compact reference for drawing, arranging and editing Excalidraw scenes"

  default: theme { font-family normal }
  arrange grid { columns 4; gap 28; width 3300 }

  read: section "Read XDraw" {
    arrange column { gap 18 }

    anatomy: code """
      request: rectangle "Request" {
        body "Supporting detail"
        size (240, 120)
      }

      # request   = stable source ID
      # rectangle = constructor
      # "Request" = visible label
      # { ... }   = properties and children
    """ {
      title "Declaration anatomy"
      language xdraw
      line-numbers false
      highlight true
    }

    primitives: code """
      # Shapes: rectangle, ellipse, diamond
      # Containers: frame, group, section
      # Content: freedraw, text, code, asset, image
      # Definitions: template, style, theme
    """ {
      title "Primitive constructors"
      language xdraw
      line-numbers false
      highlight true
    }

    forms: code """
      # Structure: diagram, use, arrange
      # Edges: ->, --, @top, @right, @bottom, @left
      # Geometry: align, distribute, match-size,
      #           offset, rotate, snap
      # Scenes: scene, replace, patch, update,
      #         delete, add
    """ {
      title "Language forms and operators"
      language xdraw
      line-numbers false
      highlight true
    }

    libraries: code """
      use "xdraw/architecture" as arch

      api: arch.system "API"
      request: rectangle "Request"

      # Qualified constructors come from imports.
      # They add semantic vocabulary over the core.
    """ {
      title "Core primitives vs libraries"
      language xdraw
      line-numbers false
      highlight true
    }

    document: code """

      diagram "Compiler flow" {
        source: rectangle "Source text"
        target: rectangle "Scene graph"
        source -> target "compiles"
      }
    """ {
      title "Document"
      language xdraw
      line-numbers false
      highlight true
    }

    shortcuts: code """
      # Comments begin with #
      # Strings use "double quotes"
      # Multiline text uses triple quotes
      # Statements use newlines or semicolons
      # IDs remain stable in the output scene
    """ {
      title "Syntax reminders"
      language xdraw
      line-numbers false
      highlight true
    }
  }

  draw: section "Draw" {
    arrange column { gap 18 }

    shapes: code """
      task: rectangle "Task"
      event: ellipse "Complete"
      choice: diamond "Approved?"
      system: arch.system "API"
      data: arch.database "Records"
    """ {
      title "Shapes and libraries"
      language xdraw
      line-numbers false
      highlight true
    }

    freehand: code """
      mark: freedraw {
        at (100, 100)
        points ((0, 20), (30, 0), (70, 45))
        stroke "#2563eb"
        stroke-width 6
      }
    """ {
      title "Freehand stroke"
      language xdraw
      line-numbers false
      highlight true
    }

    properties: code """
      request: rectangle "Request" {
        body "Supporting detail"
        style palette.info
        size (240, 120)
        locked true
      }
    """ {
      title "Properties"
      language xdraw
      line-numbers false
      highlight true
    }

    text_and_code: code """
      caption: text "Independent text" {
        at (80, 420)
        wrap-width 260
        align center
      }

      sample: code "SELECT 1" {
        title "Query"
        language sql
        highlight true
      }
    """ {
      title "Text and code"
      language xdraw
      line-numbers false
      highlight true
    }

    connections: code """
      request: client@right -> api@left "calls" {
        route elbow
        stroke-style dashed
        head triangle
      }

      service -- database "related"
    """ {
      title "Connections and anchors"
      language xdraw
      line-numbers false
      highlight true
    }

    assets: code """
      logo: asset "assets/logo.svg"
      hero: image(logo) {
        at (80, 80)
        size (240, 120)
        fit contain
        alt "Product logo"
      }
    """ {
      title "Assets and images"
      language xdraw
      line-numbers false
      highlight true
    }

    sequence_and_notes: code """
      use "xdraw/sequence" as seq
      use "xdraw/annotations" as annotations

      interaction: seq.sequence {
        user: seq.participant "User"
        api: seq.participant "API"
        user -> api "Submit"
        api -> user "Accepted"
      }

      note: annotations.note "Review" {
        attach interaction.api@bottom
      }
    """ {
      title "Sequences and annotations"
      language xdraw
      line-numbers false
      highlight true
    }
  }

  arrange_and_reuse: section "Arrange and reuse" {
    arrange column { gap 18 }

    layouts: code """
      arrange row { gap 80 }
      arrange column { gap 24 }
      arrange grid { columns 3; gap 30 }
      arrange layered { direction right }
    """ {
      title "Automatic layouts"
      language xdraw
      line-numbers false
      highlight true
    }

    containment: code """
      platform: frame "Platform" {
        arrange row { gap 60 }
        api: arch.system "API"
        store: arch.database "Data"
      }

      platform.api -> platform.store
    """ {
      title "Containment and namespaces"
      language xdraw
      line-numbers false
      highlight true
    }

    tree: code """
      arrange tree {
        root decision
        direction right
        level-gap 90
      }
      decision -> yes
      decision -> no
    """ {
      title "Tree layout"
      language xdraw
      line-numbers false
      highlight true
    }

    geometry: code """
      align top (first, second, third)
      distribute x (first, second, third)
      match-size (first, second) both
      offset (third) by (0, 20)
      rotate (third) 5
      snap (first, second) to 10
    """ {
      title "Precision geometry"
      language xdraw
      line-numbers false
      highlight true
    }

    templates: code """
      service: template(name, visual_style) {
        api: arch.system "${name} API" {
          style $visual_style
        }
        data: arch.database "${name} data"
        api -> data
      }

      orders: service("Orders", palette.info)
    """ {
      title "Reusable templates"
      language xdraw
      line-numbers false
      highlight true
    }

  }

  operate: section "Build and edit" {
    arrange column { gap 18 }

    cli: code """
      xdraw check diagram.xdraw
      xdraw build diagram.xdraw
      xdraw build diagram.xdraw -o output.excalidraw

      cat diagram.xdraw | xdraw build -o output.excalidraw
      xdraw build < diagram.xdraw > output.excalidraw
    """ {
      title "CLI"
      language shell
      line-numbers false
    }

    address: code """
      scene excalidraw::default::architecture::overview {
        # replace or patch
      }
    """ {
      title "Hosted scene address"
      language xdraw
      line-numbers false
      highlight true
    }

    replace: code """
      scene excalidraw::default::examples::overview {
        replace {
          diagram "Overview" {
            api: rectangle "API"
          }
        }
      }
    """ {
      title "Replace the owned scene"
      language xdraw
      line-numbers false
      highlight true
    }

    patch: code """
      scene excalidraw::default::examples::overview {
        patch {
          update api { title "API v2" }
          delete legacy
          add { review: rectangle "Review" }
        }
      }
    """ {
      title "Patch known source IDs"
      language xdraw
      line-numbers false
      highlight true
    }

    hosted_cli: code """
      export EXCALIDRAW_API_KEY="your-api-key"

      xdraw list
      xdraw apply overview.scene.xdraw
      xdraw pull "excalidraw::default::Examples::Overview"
      xdraw pull <scene-id> -o overview.png
    """ {
      title "Excalidraw+ commands"
      language shell
      line-numbers false
    }

  }
}
