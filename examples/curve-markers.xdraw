use "xdraw/math" as math

diagram "Markers placed along a curve" {
  subtitle "Each label sits at a fraction of the curve's own length, not of its parameter"

  let cx = 530
  let cy = 420
  let reach = 260

  spiral: math.plot {
    at = (cx, cy)
    x = 13 * t * cos(t)
    y = 13 * t * sin(t)
    t in [0, 20]
    stroke = "#0891b2"
    stroke-width = 1
  }

  start: text "start" {
    at = along(spiral, 0) + (14, 0)
    font-size = 19
  }
  quarter: text "a quarter along" {
    at = along(spiral, 0.25) + (14, 0)
    font-size = 19
  }
  half: text "halfway" {
    at = along(spiral, 0.5) + (14, 0)
    font-size = 19
  }
  threequarter: text "three quarters" {
    at = along(spiral, 0.75) + (14, 0)
    font-size = 19
  }
  finish: text "end" {
    at = along(spiral, 1) + (14, 0)
    font-size = 19
  }

  note: text "the four gaps are equal lengths of line, so they crowd where the spiral is tight" {
    at = (140, 700)
    font-size = 19
  }
}
