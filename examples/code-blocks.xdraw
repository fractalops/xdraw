diagram "How code blocks render" {
  subtitle "XDraw preserves editable source, indentation and token-level color"
  arrange grid { columns 2; gap 32 }

  typescript: code """
    type Stage = "syntax" | "semantic" | "scene"

    function compile(stage: Stage) {
      return `Compiling: ${stage}`
    }
  """ {
    language typescript
    highlight true
  }

  sql: code """
    SELECT
      language,
      COUNT(*) AS code_blocks
    FROM xdraw_examples
    GROUP BY language
  """ {
    language sql
    line-numbers false
    highlight true
  }
}
