{
  "name": "xdraw",
  "version": "0.1.0",
  "description": "Create editable Excalidraw diagrams from concise text files.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fractalops/xdraw.git"
  },
  "bugs": "https://github.com/fractalops/xdraw/issues",
  "homepage": "https://github.com/fractalops/xdraw#readme",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "engines": {
    "node": ">=22.18.0"
  },
  "files": [
    "bin/",
    "lib/",
    "examples/",
    "docs/",
    "README.md"
  ],
  "bin": {
    "xdraw": "./bin/xdraw.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./excalidraw-api": {
      "types": "./lib/excalidraw-api.d.ts",
      "import": "./lib/excalidraw-api.js",
      "default": "./lib/excalidraw-api.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "example:compiler": "node bin/xdraw.js build examples/compiler-flow.xdraw -o output/compiler-flow.excalidraw",
    "example:architecture": "node bin/xdraw.js build examples/xdraw-architecture.xdraw -o output/xdraw-architecture.excalidraw",
    "docs:images": "node bin/xdraw.js build examples/xdraw-logo.xdraw -o docs/images/xdraw-logo.png --background transparent && node bin/xdraw.js build examples/readme-cheatsheet.xdraw -o docs/images/readme-cheatsheet.png",
    "generate:font-metrics": "node scripts/generate-font-metrics.mjs",
    "check:font-metrics": "node scripts/generate-font-metrics.mjs --check",
    "check:sources": "node scripts/check-production-sources.mjs",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "npm run typecheck:core",
    "typecheck:core": "tsc -p tsconfig.json",
    "test:types": "npm run build && tsc -p type-tests/tsconfig.json",
    "test": "node --test",
    "test:properties": "node --test test/properties.test.js",
    "test:corpus": "node --test test/corpus.test.js",
    "test:browser": "npm run build && playwright test",
    "build:acceptance-host": "vite build --config acceptance/vite.config.ts",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "elkjs": "^0.11.0",
    "eslint": "^10.8.1",
    "fast-check": "^4.9.0",
    "fontkit": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.2.2"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@shikijs/langs": "4.4.3",
    "@shikijs/themes": "4.4.3",
    "fractional-indexing": "^3.2.0",
    "perfect-freehand": "^1.2.0",
    "shiki": "4.4.3"
  },
  "overrides": {
    "@excalidraw/excalidraw": {
      "nanoid": "3.3.18"
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "6.0.1"
    },
    "lodash-es": "4.18.1"
  }
}
