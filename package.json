{
  "name": "xdraw",
  "version": "0.1.0",
  "description": "Create editable Excalidraw diagrams from concise text files.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fractalops/xdraw.git"
  },
  "bugs": "https://github.com/fractalops/xdraw/issues",
  "homepage": "https://github.com/fractalops/xdraw#readme",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "engines": {
    "node": ">=22.18.0"
  },
  "files": [
    "bin/",
    "lib/",
    "examples/",
    "docs/language-reference.md",
    "README.md"
  ],
  "bin": {
    "xdraw": "./bin/xdraw.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./excalidraw-api": {
      "types": "./lib/excalidraw-api.d.ts",
      "import": "./lib/excalidraw-api.js",
      "default": "./lib/excalidraw-api.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/clean-lib.mjs && tsc -p tsconfig.build.json && node scripts/rewrite-declaration-imports.mjs && node --check bin/xdraw.js",
    "example:order": "node bin/xdraw.js build examples/order-flow.xdraw -o output/order-flow.excalidraw",
    "example:platform": "node bin/xdraw.js build examples/platform-overview.xdraw -o output/platform-overview.excalidraw",
    "generate:font-metrics": "node scripts/generate-font-metrics.mjs",
    "typecheck": "npm run typecheck:core",
    "typecheck:core": "tsc -p tsconfig.json",
    "test:types": "npm run build && tsc -p type-tests/tsconfig.json",
    "test": "node --test",
    "test:corpus": "node --test test/corpus.test.js",
    "test:browser": "npm run build && playwright test",
    "build:acceptance-host": "vite build --config acceptance/vite.config.ts",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "elkjs": "^0.11.0",
    "fontkit": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2"
  },
  "overrides": {
    "@excalidraw/excalidraw": {
      "nanoid": "3.3.18"
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "6.0.1"
    },
    "lodash-es": "4.18.1"
  }
}
